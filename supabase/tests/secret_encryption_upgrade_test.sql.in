-- Replay the real migration over legacy bytes and a key emitted by old rotation.
begin;
select plan(9);
select vault.create_secret(encode(decode(repeat('ab', 32), 'hex'), 'base64'),
    'master_encryption_key', 'transaction-local upgrade fixture');
insert into auth.users (id, email) values
    ('61900000-0000-4000-8000-000000000001', 'upgrade@pgtap.test');
insert into public.secrets (id, user_id, website, username, password_encrypted) values
    ('61900000-0000-4000-8000-000000000002', '61900000-0000-4000-8000-000000000001', 'upgrade.example', 'fixture',
     encode(extensions.encrypt(convert_to($text$a\b\\c café$text$, 'UTF8'), public.get_encryption_key()::bytea, 'aes'), 'base64'));
alter table public.secret_metadata disable trigger encrypt_twofa_secret_trigger;
insert into public.secret_metadata (secret_id, twofa_enabled, twofa_type, twofa_secret, recovery_codes_encrypted) values
    ('61900000-0000-4000-8000-000000000002', true, 'app',
     'v1:' || encode(extensions.encrypt(convert_to('JBSWY3DPEHPK3PXP', 'UTF8'), public.get_encryption_key()::bytea, 'aes'), 'base64'),
     encode(extensions.encrypt(convert_to('["code-one"]', 'UTF8'), public.get_encryption_key()::bytea, 'aes'), 'base64'));
alter table public.secret_metadata enable trigger encrypt_twofa_secret_trigger;

\ir ../migrations/20260913000000_authenticated_secret_encryption.sql

select is(public.get_encryption_key(), encode(decode(repeat('ab', 32), 'hex'), 'base64'),
    'upgrade preserves the existing base64 vault key');
select is((select public.decrypt_text(password_encrypted) from public.secrets where website = 'upgrade.example'),
    $text$a\b\\c café$text$, 'backfill preserves literal backslashes and UTF-8 bytes');
select is((select public.safe_decrypt_recovery_codes(recovery_codes_encrypted) from public.secret_metadata
    where secret_id = '61900000-0000-4000-8000-000000000002'), '["code-one"]'::jsonb, 'recovery codes survive upgrade');
select is((select public.safe_decrypt_twofa_secret(twofa_secret) from public.secret_metadata
    where secret_id = '61900000-0000-4000-8000-000000000002'), 'JBSWY3DPEHPK3PXP', 'TOTP survives upgrade');
select ok((select s.password_encrypted like 'v2:%' and sm.recovery_codes_encrypted like 'v2:%'
    and sm.twofa_secret like 'v1:v2:%' from public.secrets s join public.secret_metadata sm on sm.secret_id=s.id
    where s.website='upgrade.example'), 'all three stored fields use the v2 envelope');
create temp table upgraded_bytes as select s.password_encrypted, sm.recovery_codes_encrypted, sm.twofa_secret
    from public.secrets s join public.secret_metadata sm on sm.secret_id=s.id where s.website='upgrade.example';

\ir ../migrations/20260913000000_authenticated_secret_encryption.sql

select results_eq($$ select s.password_encrypted, sm.recovery_codes_encrypted, sm.twofa_secret
    from public.secrets s join public.secret_metadata sm on sm.secret_id=s.id where s.website='upgrade.example' $$,
    $$ select * from upgraded_bytes $$, 'replaying the migration leaves ciphertext byte-identical');
update public.secret_metadata set twofa_secret='JBSWY3DPEHPK3PXQ' where secret_id='61900000-0000-4000-8000-000000000002';
select ok((select twofa_secret like 'v1:v2:%' and public.safe_decrypt_twofa_secret(twofa_secret)='JBSWY3DPEHPK3PXQ'
    from public.secret_metadata where secret_id='61900000-0000-4000-8000-000000000002'), 'TOTP write trigger is restored');
update public.secrets set password_encrypted='corrupt' where website='upgrade.example';
select throws_ok($migration$
\ir ../migrations/20260913000000_authenticated_secret_encryption.sql
$migration$, '22000',
    'Secret encryption upgrade blocked: secrets.password_encrypted=1, secret_metadata.recovery_codes_encrypted=0, secret_metadata.twofa_secret=0 unreadable rows',
    'preflight identifies the unreadable column and count');
select is((select password_encrypted from public.secrets where website='upgrade.example'), 'corrupt',
    'failed upgrade preserves the unreadable bytes for recovery');
select * from finish();
rollback;
